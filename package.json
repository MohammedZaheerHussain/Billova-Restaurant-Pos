{
  "name": "billova",
  "version": "1.0.0",
  "description": "Billova POS - Universal, Industry-Level Billing System",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=packages/api",
    "build": "npm run build --workspaces",
    "lint": "eslint apps/web/src packages/api/src",
    "lint:fix": "eslint apps/web/src packages/api/src --fix",
    "format": "prettier --write \"apps/web/src/**/*.{ts,tsx,css}\" \"packages/api/src/**/*.ts\"",
    "format:check": "prettier --check \"apps/web/src/**/*.{ts,tsx,css}\" \"packages/api/src/**/*.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^8.2.2",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.55.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Billova",
  "license": "MIT"
}
