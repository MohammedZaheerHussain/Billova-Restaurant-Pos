// DFC POS Pro - Database Schema
// Using MySQL (MySQL Workbench - localhost:3306)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==================== BRANCH ====================
model Branch {
  id                 String           @id @default(uuid())
  name               String
  address            String?          @db.Text
  phone              String?
  email              String?
  gstNumber          String?
  isActive           Boolean          @default(true)
  subscriptionPlan   SubscriptionPlan @default(BASIC)
  subscriptionExpiry DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  // Relations
  users      User[]
  categories Category[]
  menuItems  MenuItem[]
  orders     Order[]
  tables     Table[]
  inventory  InventoryItem[]
  license    License?

  @@map("branches")
}

// Subscription Plans
enum SubscriptionPlan {
  BASIC
  PLUS
  PREMIUM
}

model User {
  id          String    @id @default(uuid())
  branchId    String
  name        String
  email       String    @unique
  phone       String?
  password    String
  role        UserRole  @default(CASHIER)
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  branch                Branch                 @relation(fields: [branchId], references: [id])
  orders                Order[]
  passwordResetRequests PasswordResetRequest[]
  supportTickets        SupportTicket[]

  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  MANAGER
  CASHIER
  KITCHEN
}

// ==================== CATEGORY ====================
model Category {
  id        String   @id @default(uuid())
  branchId  String
  name      String
  icon      String? // emoji or icon name
  color     String? // hex color for UI
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  branch    Branch     @relation(fields: [branchId], references: [id])
  menuItems MenuItem[]

  @@map("categories")
}

// ==================== MENU ITEM ====================
model MenuItem {
  id          String   @id @default(uuid())
  branchId    String
  categoryId  String
  name        String
  description String?  @db.Text
  price       Decimal  @db.Decimal(10, 2)
  image       String?  @db.Text
  isVeg       Boolean  @default(false)
  isAvailable Boolean  @default(true)
  hasGST      Boolean  @default(true)
  gstPercent  Decimal  @default(5) @db.Decimal(5, 2)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Variants (e.g., Small ₹100, Large ₹140)
  variants MenuItemVariant[]

  // Relations
  branch      Branch           @relation(fields: [branchId], references: [id])
  category    Category         @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  ingredients ItemIngredient[]

  @@map("menu_items")
}

// ==================== MENU ITEM VARIANT ====================
model MenuItemVariant {
  id         String   @id @default(uuid())
  menuItemId String
  name       String // e.g., "Small", "Large", "6 PCS", "8 PCS"
  price      Decimal  @db.Decimal(10, 2)
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  menuItem   MenuItem    @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@map("menu_item_variants")
}

// ==================== TABLE (Dine-in) ====================
model Table {
  id        String      @id @default(uuid())
  branchId  String
  name      String // e.g., "T1", "T2", "A1"
  capacity  Int         @default(4)
  status    TableStatus @default(EMPTY)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // Relations
  branch Branch  @relation(fields: [branchId], references: [id])
  orders Order[]

  @@map("tables")
}

enum TableStatus {
  EMPTY
  OCCUPIED
  RESERVED
  CLEANING
}

// ==================== ORDER ====================
model Order {
  id            String      @id @default(uuid())
  orderNumber   Int         @default(0)
  branchId      String
  tableId       String?
  userId        String
  orderType     OrderType   @default(DINE_IN)
  status        OrderStatus @default(PENDING)
  customerName  String?
  customerPhone String?

  // Amounts
  subtotal       Decimal       @db.Decimal(10, 2)
  discountType   DiscountType?
  discountValue  Decimal?      @db.Decimal(10, 2)
  discountAmount Decimal       @default(0) @db.Decimal(10, 2)
  gstAmount      Decimal       @default(0) @db.Decimal(10, 2)
  total          Decimal       @db.Decimal(10, 2)

  // Online order info
  onlineOrderId  String? // Swiggy/Zomato order ID
  onlinePlatform String? // "SWIGGY", "ZOMATO"

  notes       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  // Relations
  branch   Branch      @relation(fields: [branchId], references: [id])
  table    Table?      @relation(fields: [tableId], references: [id])
  user     User        @relation(fields: [userId], references: [id])
  items    OrderItem[]
  payments Payment[]
  kotItems KOTItem[]

  @@map("orders")
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  ONLINE
  DELIVERY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

// ==================== ORDER ITEM ====================
model OrderItem {
  id         String          @id @default(uuid())
  orderId    String
  menuItemId String
  variantId  String?
  quantity   Int             @default(1)
  unitPrice  Decimal         @db.Decimal(10, 2)
  total      Decimal         @db.Decimal(10, 2)
  notes      String? // e.g., "Extra spicy", "No onion"
  status     OrderItemStatus @default(PENDING)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  // Relations
  order    Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem         @relation(fields: [menuItemId], references: [id])
  variant  MenuItemVariant? @relation(fields: [variantId], references: [id])

  @@map("order_items")
}

enum OrderItemStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

// ==================== PAYMENT ====================
model Payment {
  id        String      @id @default(uuid())
  orderId   String
  mode      PaymentMode
  amount    Decimal     @db.Decimal(10, 2)
  reference String? // UPI ref, card last 4 digits, etc.
  createdAt DateTime    @default(now())

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

enum PaymentMode {
  CASH
  CARD
  UPI
  WALLET
  ONLINE // For Swiggy/Zomato
  SPLIT
}

// ==================== KOT (Kitchen Order Ticket) ====================
model KOTItem {
  id          String    @id @default(uuid())
  orderId     String
  kotNumber   Int
  itemName    String
  quantity    Int
  notes       String?
  status      KOTStatus @default(PENDING)
  printedAt   DateTime  @default(now())
  completedAt DateTime?

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("kot_items")
}

enum KOTStatus {
  PENDING
  PREPARING
  READY
}

// ==================== INVENTORY ====================
model InventoryItem {
  id          String            @id @default(uuid())
  branchId    String
  sku         String? // Stock keeping unit
  name        String
  category    InventoryCategory @default(INGREDIENT)
  unit        String // kg, ltr, pcs, etc.
  quantity    Decimal           @db.Decimal(10, 3)
  minStock    Decimal           @default(0) @db.Decimal(10, 3)
  safetyStock Decimal           @default(0) @db.Decimal(10, 3) // Safety buffer
  reservedQty Decimal           @default(0) @db.Decimal(10, 3) // Reserved for online orders
  costPerUnit Decimal           @default(0) @db.Decimal(10, 2)
  expiryDate  DateTime? // For expiry tracking
  stockStatus StockStatus       @default(SUFFICIENT)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Relations
  branch           Branch                 @relation(fields: [branchId], references: [id])
  ingredients      ItemIngredient[]
  transactions     StockTransaction[]
  alerts           StockAlert[]
  approvalRequests StockApprovalRequest[]

  @@map("inventory_items")
}

enum InventoryCategory {
  INGREDIENT
  PACKAGING
  BEVERAGE
  RAW_MATERIAL
  FINISHED_GOODS
  OTHER
}

enum StockStatus {
  SUFFICIENT
  LOW_STOCK
  CRITICAL
  OUT_OF_STOCK
}

// ==================== ITEM INGREDIENT MAPPING ====================
model ItemIngredient {
  id              String  @id @default(uuid())
  menuItemId      String
  inventoryItemId String
  quantityUsed    Decimal @db.Decimal(10, 3) // Amount used per menu item

  // Relations
  menuItem      MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@unique([menuItemId, inventoryItemId])
  @@map("item_ingredients")
}

// ==================== STOCK TRANSACTION ====================
model StockTransaction {
  id              String          @id @default(uuid())
  inventoryItemId String
  type            TransactionType
  quantity        Decimal         @db.Decimal(10, 3)
  previousQty     Decimal?        @db.Decimal(10, 3) // For audit trail
  newQty          Decimal?        @db.Decimal(10, 3) // For audit trail
  reason          String?
  orderId         String? // Link to order for consumption tracking
  kotItemId       String? // Link to specific KOT item
  batchId         String? // Link to batch import
  performedById   String? // User who made the change
  approvedById    String? // User who approved (for manual updates)
  reference       String? // External reference
  createdAt       DateTime        @default(now())

  // Relations
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@map("stock_transactions")
}

enum TransactionType {
  PURCHASE
  SALE
  WASTAGE
  ADJUSTMENT
  CONSUMPTION // Auto-consumption from orders
  RESERVATION // Reserved for online orders
  RELEASE // Released from reservation
  BATCH_IMPORT // CSV/Excel import
}

// ==================== STOCK BATCH (CSV/Excel Import) ====================
model StockBatch {
  id           String   @id @default(uuid())
  branchId     String
  uploadedById String
  fileName     String
  totalItems   Int
  successCount Int      @default(0)
  failedCount  Int      @default(0)
  status       String   @default("PROCESSING") // PROCESSING, COMPLETED, FAILED
  errorLog     String?  @db.Text
  createdAt    DateTime @default(now())

  @@map("stock_batches")
}

// ==================== STOCK ALERT ====================
model StockAlert {
  id              String   @id @default(uuid())
  branchId        String
  inventoryItemId String
  alertType       String // LOW_STOCK, CRITICAL, OUT_OF_STOCK, EXPIRING
  message         String
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())

  // Relations
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@map("stock_alerts")
}

// ==================== STOCK APPROVAL REQUEST ====================
model StockApprovalRequest {
  id              String    @id @default(uuid())
  inventoryItemId String
  requestedById   String
  adjustmentType  String // INCREASE, DECREASE
  adjustmentQty   Decimal   @db.Decimal(10, 3)
  reason          String
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedById    String?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  processedAt     DateTime?

  // Relations
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@map("stock_approval_requests")
}

// ==================== COMBO / OFFER ====================
model Combo {
  id          String   @id @default(uuid())
  branchId    String
  name        String
  description String?  @db.Text
  price       Decimal  @db.Decimal(10, 2)
  image       String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items ComboItem[]

  @@map("combos")
}

model ComboItem {
  id       String @id @default(uuid())
  comboId  String
  itemName String // Store name directly for flexibility
  quantity Int    @default(1)

  // Relations
  combo Combo @relation(fields: [comboId], references: [id], onDelete: Cascade)

  @@map("combo_items")
}

// ==================== SETTINGS ====================
model Setting {
  id        String   @id @default(uuid())
  branchId  String?
  key       String
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, key])
  @@map("settings")
}

// ==================== LICENSE ====================
model License {
  id         String        @id @default(uuid())
  branchId   String        @unique
  licenseKey String        @unique
  plan       LicensePlan   @default(BASIC)
  status     LicenseStatus @default(ACTIVE)
  expiresAt  DateTime
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  // Relations
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("licenses")
}

enum LicensePlan {
  BASIC
  PLUS
  PREMIUM
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
}

// ==================== PASSWORD RESET REQUEST ====================
model PasswordResetRequest {
  id          String    @id @default(uuid())
  userId      String
  status      String    @default("PENDING") // PENDING, COMPLETED, CANCELLED
  requestedAt DateTime  @default(now())
  completedAt DateTime?
  newPassword String? // Admin sets this when completing

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_requests")
}

// ==================== SUPPORT TICKET ====================
model SupportTicket {
  id         String    @id @default(uuid())
  userId     String
  branchId   String
  subject    String
  message    String    @db.Text
  status     String    @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  priority   String    @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  adminReply String?   @db.Text
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("support_tickets")
}
