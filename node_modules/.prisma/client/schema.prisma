// DFC POS Pro - Database Schema
// Using MySQL (MySQL Workbench - localhost:3306)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==================== BRANCH ====================
model Branch {
  id                 String           @id @default(uuid())
  name               String
  address            String?          @db.Text
  phone              String?
  email              String?
  gstNumber          String?
  isActive           Boolean          @default(true)
  subscriptionPlan   SubscriptionPlan @default(BASIC)
  subscriptionExpiry DateTime?
  defaultWarehouseId String? // Default warehouse for POS operations
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  // Relations
  users            User[]
  categories       Category[]
  menuItems        MenuItem[]
  orders           Order[]
  tables           Table[]
  inventory        InventoryItem[]
  license          License?
  addons           MenuItemAddon[]
  warehouses       Warehouse[]
  purchaseRequests PurchaseRequest[]
  suppliers        Supplier[]

  @@map("branches")
}

// Subscription Plans
enum SubscriptionPlan {
  BASIC
  PLUS
  PREMIUM
}

model User {
  id          String    @id @default(uuid())
  branchId    String
  name        String
  email       String    @unique
  phone       String?
  password    String
  role        UserRole  @default(CASHIER)
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  branch                Branch                 @relation(fields: [branchId], references: [id])
  orders                Order[]
  passwordResetRequests PasswordResetRequest[]
  supportTickets        SupportTicket[]
  deliveryAssignments   DeliveryAssignment[]

  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  MANAGER
  CASHIER
  KITCHEN
  DRIVER
}

// ==================== CATEGORY ====================
model Category {
  id        String   @id @default(uuid())
  branchId  String
  name      String
  icon      String? // emoji or icon name
  color     String? // hex color for UI
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  branch    Branch     @relation(fields: [branchId], references: [id])
  menuItems MenuItem[]

  @@map("categories")
}

// ==================== MENU ITEM ====================
model MenuItem {
  id          String   @id @default(uuid())
  branchId    String
  categoryId  String
  name        String
  description String?  @db.Text
  price       Decimal  @db.Decimal(10, 2)
  image       String?  @db.Text
  isVeg       Boolean  @default(false)
  isAvailable Boolean  @default(true)
  hasGST      Boolean  @default(true)
  gstPercent  Decimal  @default(5) @db.Decimal(5, 2)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Variants (e.g., Small ₹100, Large ₹140)
  variants MenuItemVariant[]

  // Addons (e.g., Extra Cheese, No Onion)
  addons MenuItemAddonLink[]

  // Relations
  branch      Branch           @relation(fields: [branchId], references: [id])
  category    Category         @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  ingredients ItemIngredient[]

  @@map("menu_items")
}

// ==================== MENU ITEM VARIANT ====================
model MenuItemVariant {
  id         String   @id @default(uuid())
  menuItemId String
  name       String // e.g., "Small", "Large", "6 PCS", "8 PCS"
  price      Decimal  @db.Decimal(10, 2)
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  menuItem   MenuItem    @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@map("menu_item_variants")
}

// ==================== MENU ITEM ADDON ====================
model MenuItemAddon {
  id        String   @id @default(uuid())
  branchId  String // Addons can be shared across menu items in a branch
  name      String // e.g., "Extra Cheese", "No Onion", "Add Paneer"
  price     Decimal  @default(0) @db.Decimal(10, 2) // Additional price
  category  String   @default("Extras") // "Extras", "Remove", "Customize", "Toppings"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  branch          Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  menuItems       MenuItemAddonLink[] // Which items can have this addon
  orderItemAddons OrderItemAddon[]

  @@map("menu_item_addons")
}

// Link table for many-to-many between MenuItem and Addon
model MenuItemAddonLink {
  id         String @id @default(uuid())
  menuItemId String
  addonId    String

  menuItem MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  addon    MenuItemAddon @relation(fields: [addonId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, addonId])
  @@map("menu_item_addon_links")
}

// Track which addons were selected in an order
model OrderItemAddon {
  id          String  @id @default(uuid())
  orderItemId String
  addonId     String
  price       Decimal @db.Decimal(10, 2) // Price at time of order

  orderItem OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  addon     MenuItemAddon @relation(fields: [addonId], references: [id])

  @@map("order_item_addons")
}

// ==================== TABLE (Dine-in) ====================
model Table {
  id        String      @id @default(uuid())
  branchId  String
  name      String // e.g., "T1", "T2", "A1"
  capacity  Int         @default(4)
  status    TableStatus @default(EMPTY)
  qrToken   String?     @unique // Token for QR code ordering
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // Relations
  branch     Branch      @relation(fields: [branchId], references: [id])
  orders     Order[]
  qrSessions QRSession[]

  @@map("tables")
}

enum TableStatus {
  EMPTY
  OCCUPIED
  RESERVED
  CLEANING
}

// ==================== QR SESSION (Customer Self Order) ====================
model QRSession {
  id           String   @id @default(uuid())
  tableId      String
  sessionToken String   @unique // Unique token for this ordering session
  customerName String?
  status       String   @default("ACTIVE") // ACTIVE, ORDERED, EXPIRED
  orderId      String? // Link to created order
  createdAt    DateTime @default(now())
  expiresAt    DateTime // Session expires after X minutes

  // Relations
  table Table @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@map("qr_sessions")
}

// ==================== ORDER ====================
model Order {
  id            String      @id @default(uuid())
  orderNumber   Int         @default(0)
  branchId      String
  tableId       String?
  userId        String
  orderType     OrderType   @default(DINE_IN)
  status        OrderStatus @default(PENDING)
  customerName  String?
  customerPhone String?

  // Amounts
  subtotal       Decimal       @db.Decimal(10, 2)
  discountType   DiscountType?
  discountValue  Decimal?      @db.Decimal(10, 2)
  discountAmount Decimal       @default(0) @db.Decimal(10, 2)
  gstAmount      Decimal       @default(0) @db.Decimal(10, 2)
  total          Decimal       @db.Decimal(10, 2)

  // Online order info
  onlineOrderId  String? // Swiggy/Zomato order ID
  onlinePlatform String? // "SWIGGY", "ZOMATO"

  // Offline sync info
  offlineCreatedAt      DateTime? // Original creation time when offline
  offlineTempBillNumber String? // TEMP-XXXX format bill number

  notes       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  // Relations
  branch             Branch              @relation(fields: [branchId], references: [id])
  table              Table?              @relation(fields: [tableId], references: [id])
  user               User                @relation(fields: [userId], references: [id])
  items              OrderItem[]
  payments           Payment[]
  kotItems           KOTItem[]
  deliveryAssignment DeliveryAssignment?

  @@map("orders")
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  ONLINE
  DELIVERY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

// ==================== ORDER ITEM ====================
model OrderItem {
  id         String          @id @default(uuid())
  orderId    String
  menuItemId String
  variantId  String?
  quantity   Int             @default(1)
  unitPrice  Decimal         @db.Decimal(10, 2)
  total      Decimal         @db.Decimal(10, 2)
  notes      String? // e.g., "Extra spicy", "No onion"
  status     OrderItemStatus @default(PENDING)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  // Relations
  order    Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem         @relation(fields: [menuItemId], references: [id])
  variant  MenuItemVariant? @relation(fields: [variantId], references: [id])
  addons   OrderItemAddon[]

  @@map("order_items")
}

enum OrderItemStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

// ==================== PAYMENT ====================
model Payment {
  id        String      @id @default(uuid())
  orderId   String
  mode      PaymentMode
  amount    Decimal     @db.Decimal(10, 2)
  reference String? // UPI ref, card last 4 digits, etc.
  createdAt DateTime    @default(now())

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

enum PaymentMode {
  CASH
  CARD
  UPI
  WALLET
  ONLINE // For Swiggy/Zomato
  SPLIT
}

// ==================== KOT (Kitchen Order Ticket) ====================
model KOTItem {
  id          String    @id @default(uuid())
  orderId     String
  kotNumber   Int
  itemName    String
  quantity    Int
  notes       String?
  status      KOTStatus @default(PENDING)
  printedAt   DateTime  @default(now())
  completedAt DateTime?

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("kot_items")
}

enum KOTStatus {
  PENDING
  PREPARING
  READY
}

// ==================== INVENTORY ====================
model InventoryItem {
  id          String            @id @default(uuid())
  branchId    String
  sku         String? // Stock keeping unit
  name        String
  category    InventoryCategory @default(INGREDIENT)
  unit        String // kg, ltr, pcs, etc.
  quantity    Decimal           @db.Decimal(10, 3)
  minStock    Decimal           @default(0) @db.Decimal(10, 3)
  safetyStock Decimal           @default(0) @db.Decimal(10, 3) // Safety buffer
  reservedQty Decimal           @default(0) @db.Decimal(10, 3) // Reserved for online orders
  costPerUnit Decimal           @default(0) @db.Decimal(10, 2)
  expiryDate  DateTime? // For expiry tracking
  stockStatus StockStatus       @default(SUFFICIENT)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Relations
  branch               Branch                 @relation(fields: [branchId], references: [id])
  ingredients          ItemIngredient[]
  transactions         StockTransaction[]
  alerts               StockAlert[]
  approvalRequests     StockApprovalRequest[]
  warehouseStock       WarehouseStock[]
  transferItems        StockTransferItem[]
  purchaseRequestItems PurchaseRequestItem[]
  stockAdjustments     StockAdjustment[]
  supplierPOItems      SupplierPOItem[]
  goodsReceiptItems    GoodsReceiptItem[]

  @@map("inventory_items")
}

enum InventoryCategory {
  INGREDIENT
  PACKAGING
  BEVERAGE
  RAW_MATERIAL
  FINISHED_GOODS
  OTHER
}

enum StockStatus {
  SUFFICIENT
  LOW_STOCK
  CRITICAL
  OUT_OF_STOCK
}

// ==================== ITEM INGREDIENT MAPPING ====================
model ItemIngredient {
  id              String  @id @default(uuid())
  menuItemId      String
  inventoryItemId String
  quantityUsed    Decimal @db.Decimal(10, 3) // Amount used per menu item

  // Relations
  menuItem      MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@unique([menuItemId, inventoryItemId])
  @@map("item_ingredients")
}

// ==================== STOCK TRANSACTION ====================
model StockTransaction {
  id              String          @id @default(uuid())
  inventoryItemId String
  type            TransactionType
  quantity        Decimal         @db.Decimal(10, 3)
  previousQty     Decimal?        @db.Decimal(10, 3) // For audit trail
  newQty          Decimal?        @db.Decimal(10, 3) // For audit trail
  reason          String?
  orderId         String? // Link to order for consumption tracking
  kotItemId       String? // Link to specific KOT item
  batchId         String? // Link to batch import
  performedById   String? // User who made the change
  approvedById    String? // User who approved (for manual updates)
  reference       String? // External reference
  createdAt       DateTime        @default(now())

  // Relations
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@map("stock_transactions")
}

enum TransactionType {
  PURCHASE
  SALE
  WASTAGE
  ADJUSTMENT
  CONSUMPTION // Auto-consumption from orders
  RESERVATION // Reserved for online orders
  RELEASE // Released from reservation
  BATCH_IMPORT // CSV/Excel import
  DAMAGE // Damaged stock
  EXPIRED // Expired stock
  PRODUCTION_USE // Used in production
  TRANSFER_OUT // Transferred out to another warehouse
  TRANSFER_IN // Transferred in from another warehouse
  GRN_RECEIPT // Received via Goods Receipt Note
}

// ==================== STOCK BATCH (CSV/Excel Import) ====================
model StockBatch {
  id           String   @id @default(uuid())
  branchId     String
  uploadedById String
  fileName     String
  totalItems   Int
  successCount Int      @default(0)
  failedCount  Int      @default(0)
  status       String   @default("PROCESSING") // PROCESSING, COMPLETED, FAILED
  errorLog     String?  @db.Text
  createdAt    DateTime @default(now())

  @@map("stock_batches")
}

// ==================== STOCK ALERT ====================
model StockAlert {
  id              String   @id @default(uuid())
  branchId        String
  inventoryItemId String
  alertType       String // LOW_STOCK, CRITICAL, OUT_OF_STOCK, EXPIRING
  message         String
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())

  // Relations
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@map("stock_alerts")
}

// ==================== STOCK APPROVAL REQUEST ====================
model StockApprovalRequest {
  id              String    @id @default(uuid())
  inventoryItemId String
  requestedById   String
  adjustmentType  String // INCREASE, DECREASE
  adjustmentQty   Decimal   @db.Decimal(10, 3)
  reason          String
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedById    String?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  processedAt     DateTime?

  // Relations
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@map("stock_approval_requests")
}

// ==================== COMBO / OFFER ====================
model Combo {
  id          String   @id @default(uuid())
  branchId    String
  name        String
  description String?  @db.Text
  price       Decimal  @db.Decimal(10, 2)
  image       String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items ComboItem[]

  @@map("combos")
}

model ComboItem {
  id       String @id @default(uuid())
  comboId  String
  itemName String // Store name directly for flexibility
  quantity Int    @default(1)

  // Relations
  combo Combo @relation(fields: [comboId], references: [id], onDelete: Cascade)

  @@map("combo_items")
}

// ==================== SETTINGS ====================
model Setting {
  id        String   @id @default(uuid())
  branchId  String?
  key       String
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, key])
  @@map("settings")
}

// ==================== LICENSE ====================
model License {
  id         String        @id @default(uuid())
  branchId   String        @unique
  licenseKey String        @unique
  plan       LicensePlan   @default(BASIC)
  status     LicenseStatus @default(ACTIVE)
  expiresAt  DateTime
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  // Relations
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("licenses")
}

enum LicensePlan {
  BASIC
  PLUS
  PREMIUM
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
}

// ==================== PASSWORD RESET REQUEST ====================
model PasswordResetRequest {
  id          String    @id @default(uuid())
  userId      String
  status      String    @default("PENDING") // PENDING, COMPLETED, CANCELLED
  requestedAt DateTime  @default(now())
  completedAt DateTime?
  newPassword String? // Admin sets this when completing

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_requests")
}

// ==================== SUPPORT TICKET ====================
model SupportTicket {
  id         String    @id @default(uuid())
  userId     String
  branchId   String
  subject    String
  message    String    @db.Text
  status     String    @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  priority   String    @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  adminReply String?   @db.Text
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("support_tickets")
}

// ==================== WAREHOUSE (Multi-location Inventory) ====================
model Warehouse {
  id        String   @id @default(uuid())
  branchId  String
  name      String
  address   String?  @db.Text
  isMain    Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  branch        Branch           @relation(fields: [branchId], references: [id])
  stock         WarehouseStock[]
  transfersFrom StockTransfer[]  @relation("TransferFrom")
  transfersTo   StockTransfer[]  @relation("TransferTo")
  zones         WarehouseZone[]

  @@map("warehouses")
}

model WarehouseStock {
  id              String    @id @default(uuid())
  warehouseId     String
  inventoryItemId String
  binId           String? // Optional bin location for precise tracking
  quantity        Decimal   @db.Decimal(10, 2)
  minStock        Decimal?  @db.Decimal(10, 2)
  batchNumber     String? // For batch/lot tracking
  expiryDate      DateTime? // For expiry tracking
  costPrice       Decimal?  @db.Decimal(10, 2) // Cost at which stock was received
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  bin           WarehouseBin? @relation(fields: [binId], references: [id])

  @@unique([warehouseId, inventoryItemId]) // Keep original constraint
  @@index([binId]) // Add index for bin lookups
  @@map("warehouse_stock")
}

model StockTransfer {
  id              String    @id @default(uuid())
  branchId        String
  fromWarehouseId String
  toWarehouseId   String
  transferNumber  Int       @default(0)
  status          String    @default("PENDING") // PENDING, APPROVED, IN_TRANSIT, COMPLETED, CANCELLED
  notes           String?   @db.Text
  requestedBy     String
  approvedBy      String?
  createdAt       DateTime  @default(now())
  approvedAt      DateTime?
  completedAt     DateTime?

  // Relations
  fromWarehouse Warehouse           @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse           @relation("TransferTo", fields: [toWarehouseId], references: [id])
  items         StockTransferItem[]

  @@map("stock_transfers")
}

model StockTransferItem {
  id              String  @id @default(uuid())
  transferId      String
  inventoryItemId String
  quantity        Decimal @db.Decimal(10, 2)

  // Relations
  transfer      StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@map("stock_transfer_items")
}

// ==================== DELIVERY ASSIGNMENT ====================
model DeliveryAssignment {
  id          String    @id @default(uuid())
  orderId     String    @unique
  driverId    String?
  status      String    @default("ASSIGNED") // ASSIGNED, PICKED_UP, IN_TRANSIT, DELIVERED, FAILED
  pickedUpAt  DateTime?
  deliveredAt DateTime?
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver User? @relation(fields: [driverId], references: [id])

  @@map("delivery_assignments")
}

// ==================== PURCHASE REQUEST (Intent Request) ====================
model PurchaseRequest {
  id            String    @id @default(uuid())
  branchId      String
  requestNumber Int       @default(0)
  requestedBy   String
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED, ORDERED, RECEIVED
  notes         String?   @db.Text
  priority      String    @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  createdAt     DateTime  @default(now())
  approvedAt    DateTime?
  approvedBy    String?

  // Relations
  branch Branch                @relation(fields: [branchId], references: [id])
  items  PurchaseRequestItem[]

  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id              String  @id @default(uuid())
  requestId       String
  inventoryItemId String
  quantity        Decimal @db.Decimal(10, 2)
  notes           String?

  // Relations
  request       PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem   @relation(fields: [inventoryItemId], references: [id])

  @@map("purchase_request_items")
}

// ==================== WAREHOUSE LOCATION HIERARCHY ====================

// Zone (Top level) - e.g., "Food Storage", "Electronics", "Raw Materials"
model WarehouseZone {
  id          String   @id @default(uuid())
  warehouseId String
  name        String
  code        String // e.g., "Z01", "Z02"
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  warehouse Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  racks     WarehouseRack[]

  @@unique([warehouseId, code])
  @@map("warehouse_zones")
}

// Rack (Inside Zone) - e.g., "Rack A", "Rack B"
model WarehouseRack {
  id        String   @id @default(uuid())
  zoneId    String
  name      String
  code      String // e.g., "R01", "R02"
  levels    Int      @default(1) // Number of shelf levels
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  zone WarehouseZone  @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  bins WarehouseBin[]

  @@unique([zoneId, code])
  @@map("warehouse_racks")
}

// Bin (Inside Rack) - e.g., "Bin 1", "Bin 2", or special areas
model WarehouseBin {
  id        String   @id @default(uuid())
  rackId    String
  name      String
  code      String // e.g., "B01", "B02"
  binType   BinType  @default(STORAGE)
  capacity  Int? // Optional capacity limit
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  rack  WarehouseRack    @relation(fields: [rackId], references: [id], onDelete: Cascade)
  stock WarehouseStock[]

  @@unique([rackId, code])
  @@map("warehouse_bins")
}

enum BinType {
  STORAGE // Normal storage
  TRANSIT // Items being moved
  DAMAGE // Damaged items
  EXPIRED // Expired items
  QUARANTINE // Items under inspection
}

// ==================== SUPPLIER MANAGEMENT ====================

model Supplier {
  id           String   @id @default(uuid())
  branchId     String
  name         String
  code         String? // Supplier code e.g., "SUP001"
  phone        String?
  email        String?
  address      String?  @db.Text
  gstNumber    String?
  paymentTerms String? // e.g., "Net 30", "Immediate"
  rating       Int?     @default(3) // 1-5 rating
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  branch         Branch                  @relation(fields: [branchId], references: [id])
  purchaseOrders SupplierPurchaseOrder[]

  @@map("suppliers")
}

// ==================== PURCHASE ORDER SYSTEM ====================

model SupplierPurchaseOrder {
  id           String    @id @default(uuid())
  branchId     String
  supplierId   String
  poNumber     Int       @default(0)
  status       POStatus  @default(DRAFT)
  expectedDate DateTime?
  notes        String?   @db.Text
  totalAmount  Decimal   @default(0) @db.Decimal(12, 2)
  createdBy    String
  approvedBy   String?
  createdAt    DateTime  @default(now())
  approvedAt   DateTime?
  updatedAt    DateTime  @updatedAt

  // Relations
  supplier Supplier         @relation(fields: [supplierId], references: [id])
  items    SupplierPOItem[]
  receipts GoodsReceipt[]

  @@map("supplier_purchase_orders")
}

enum POStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ORDERED
  PARTIAL_RECEIVED
  RECEIVED
  CANCELLED
}

model SupplierPOItem {
  id              String  @id @default(uuid())
  purchaseOrderId String
  inventoryItemId String
  orderedQty      Decimal @db.Decimal(10, 3)
  receivedQty     Decimal @default(0) @db.Decimal(10, 3)
  unitPrice       Decimal @db.Decimal(10, 2)
  notes           String?

  // Relations
  purchaseOrder SupplierPurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem         @relation(fields: [inventoryItemId], references: [id])

  @@map("supplier_po_items")
}

// ==================== GOODS RECEIPT (GRN) ====================

model GoodsReceipt {
  id              String   @id @default(uuid())
  purchaseOrderId String
  grnNumber       Int      @default(0)
  warehouseId     String
  binId           String? // Which bin to store
  batchNumber     String?
  receivedBy      String
  receivedAt      DateTime @default(now())
  notes           String?  @db.Text
  status          String   @default("COMPLETED") // PENDING, COMPLETED, REJECTED

  // Relations
  purchaseOrder SupplierPurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  items         GoodsReceiptItem[]

  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id              String  @id @default(uuid())
  receiptId       String
  inventoryItemId String
  quantity        Decimal @db.Decimal(10, 3)
  acceptedQty     Decimal @db.Decimal(10, 3) // Qty accepted (may differ from qty received)
  rejectedQty     Decimal @default(0) @db.Decimal(10, 3) // Qty rejected
  rejectionReason String?

  // Relations
  receipt       GoodsReceipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@map("goods_receipt_items")
}

// ==================== STOCK ADJUSTMENT (Damage/Expired/Wastage) ====================

model StockAdjustment {
  id              String           @id @default(uuid())
  branchId        String
  inventoryItemId String
  warehouseId     String
  fromBinId       String? // Original bin
  toBinId         String? // Destination bin (for damage/expired area)
  adjustmentType  AdjustmentType
  quantity        Decimal          @db.Decimal(10, 3)
  reason          String
  notes           String?          @db.Text
  batchNumber     String?
  performedBy     String
  approvedBy      String?
  status          AdjustmentStatus @default(PENDING)
  createdAt       DateTime         @default(now())
  processedAt     DateTime?

  // Relations
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@map("stock_adjustments")
}

enum AdjustmentType {
  DAMAGE
  EXPIRED
  WASTAGE
  PRODUCTION_USE
  CORRECTION_ADD
  CORRECTION_SUBTRACT
  INTERNAL_USE
  SAMPLE
  RETURN_TO_SUPPLIER
}

enum AdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// ==================== OFFLINE SYNC LOG ====================
// Tracks synced offline orders for duplicate detection
model OfflineSyncLog {
  id         String   @id @default(uuid())
  localId    String // Client-side UUID
  orderHash  String   @unique // Hash of order content for duplicate detection
  serverId   String // Server-generated order ID
  billNumber String // Real bill number assigned
  branchId   String
  userId     String
  syncedAt   DateTime @default(now())

  @@index([localId])
  @@index([branchId])
  @@map("offline_sync_logs")
}
