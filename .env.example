# Billova POS - Production Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# SUPABASE (Required - Cloud Database & Auth)
# ============================================
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_AUTH_ONLY=true

# ============================================
# API Server Configuration
# ============================================
# JWT secret for API (generate with: openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_here

# Frontend URL (your domain)
FRONTEND_URL=https://your-domain.com

# Groq AI API Key (for menu card scanning)
GROQ_API_KEY=your_groq_api_key

# ============================================
# Frontend (Vite Build Variables)
# ============================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key
VITE_API_URL=https://your-domain.com/api
VITE_SUPABASE_AUTH_ONLY=true

# ============================================
# SSL/Domain Configuration
# ============================================
DOMAIN=your-domain.com
EMAIL=your-email@example.com
