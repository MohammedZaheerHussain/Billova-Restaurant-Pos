# Billova POS - Production Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# MySQL Database
# ============================================
MYSQL_ROOT_PASSWORD=your_strong_password_here

# ============================================
# API Server
# ============================================
# JWT secret - generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here

# Frontend URL (your domain)
FRONTEND_URL=https://your-domain.com

# Groq AI API Key (for menu card scanning)
GROQ_API_KEY=your_groq_api_key

# ============================================
# Supabase Configuration (Dual-Auth Mode)
# ============================================
# Your Supabase project credentials
SUPABASE_URL=https://pbuqzfrffquziystkvcy.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_PUBLISHABLE_KEY=sb_publishable_fZ4bH_3ucI5XdLfCvGq3Tg_7TVFJcIc

# Feature Flags for Gradual Rollout
SUPABASE_SHADOW_WRITE=true
DUAL_AUTH_ENABLED=true
SUPABASE_AUTH_ONLY=false

# ============================================
# Frontend Environment Variables
# ============================================
